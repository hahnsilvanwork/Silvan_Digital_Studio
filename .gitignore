.worktrees/
.superpowers/
.next/
node_modules/
.env*.local
playwright-report/
test-results/
coverage/
*.tsbuildinfo
.scratch/
.idea/

# Original photography. The site serves derived, EXIF-stripped assets committed
# under public/images/; the full-resolution sources stay local. They are far
# larger than anything served and carry camera and location metadata.
/*.jpg
/*.jpeg

# Full-resolution NFC product sources stay local. The site serves the
# metadata-stripped WebP derivatives committed under public/images/products/.
/assets/nfc-products/source/*.png

# Throwaway scripts used to drive a browser or probe the running build during an
# audit. They are written to the repo root so Node resolves the project's own
# dependencies, and they are never part of the site.
.tmp-*
