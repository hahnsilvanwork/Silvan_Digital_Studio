{
  "name": "silvan-digital-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "npm run demos:build && npm run demos:sync",
    "demos:build": "node scripts/build-demos.mjs",
    "demos:install": "node scripts/build-demos.mjs --install --install-only",
    "check:availability": "node scripts/check-availability.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demos:sync": "node scripts/sync-demos.mjs",
    "demos:screenshots": "node scripts/capture-demo-projects.mjs",
    "demos:prepare-vercel": "node scripts/prepare-vercel-demos.mjs",
    "demos:serve-standalone": "node scripts/serve-vercel-demos.mjs",
    "demos:verify-standalone": "node scripts/verify-standalone-demos.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "26.1.0",
    "postcss": "8.5.23",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.1.4",
    "rollup": "4.62.0",
    "typescript-eslint": "8.46.0"
  }
}
