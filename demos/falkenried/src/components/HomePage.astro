---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Lang } from '../i18n/nav';
import garden from '../assets/images/garden/garden-path.jpg';
import workshop from '../assets/images/bmw/workshop-hero.jpg';
import apartment from '../assets/images/immobilien/apartment-living-1.jpg';
interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const divisions = [
  { route: 'bmw' as const, image: workshop, title: de ? 'Gut unterwegs.' : 'Ready for the road.', name: de ? 'Autowerkstatt' : 'Car servicing', text: de ? 'Vom regelmässigen Service bis zur Reparatur: Entdecken Sie Leistungen rund um Ihr Fahrzeug.' : 'From regular servicing to repairs: explore services for your vehicle.', alt: de ? 'Fahrzeug vor einem hellen Werkstattgebäude' : 'A car outside a bright workshop building' },
  { route: 'gartenbau' as const, image: garden, title: de ? 'Draussen zu Hause.' : 'At home outdoors.', name: de ? 'Gartenbau' : 'Landscaping', text: de ? 'Gärten gestalten, Lieblingsplätze pflegen und Neues wachsen lassen. Finden Sie die passende Unterstützung.' : 'Create a garden you love and keep it looking its best. Explore design and maintenance services.', alt: de ? 'Wassergarten mit gestuften Becken und üppiger Bepflanzung' : 'A water garden with stepped pools and lush planting' },
  { route: 'immobilien' as const, image: apartment, title: de ? 'Raum zum Ankommen.' : 'Room to settle in.', name: de ? 'Immobilien' : 'Property', text: de ? 'Wohnungen, Gewerberäume und Parkplätze: Lernen Sie das beispielhafte Immobilienangebot kennen.' : 'Apartments, commercial spaces and parking: explore the example properties.', alt: de ? 'Lichtdurchfluteter Wohnraum mit grossen Fenstern' : 'A light-filled living space with large windows' },
];
---
<BaseLayout lang={lang} route="home" title={de ? 'Falkenried Gruppe | Mobilität, Gartenbau & Immobilien' : 'Falkenried Gruppe | Motoring, gardens & property'} description={de ? 'So könnte ein regionales Unternehmen auftreten: drei Bereiche, klare Leistungen und kurze Wege zur passenden Anfrage.' : 'A regional business concept bringing motoring, landscaping and property together with clear services and simple enquiries.'}>
  <section class="group-hero">
    <div class="group-hero-copy">
      <p class="group-location">{de ? 'Falkenried Gruppe · Zürcher Unterland' : 'Falkenried Gruppe · Zurich region'}</p>
      <h1>{de ? 'Für das Leben.' : 'For everyday life.'}<br /><em>{de ? 'Für morgen.' : 'For tomorrow.'}</em></h1>
      <p class="group-intro">{de ? 'Gut unterwegs sein. Im Grünen aufatmen. Einen Ort zum Ankommen finden.' : 'Stay on the move. Breathe in the outdoors. Find a place to call your own.'}</p>
      <p class="group-description">{de ? 'Autowerkstatt, Gartenbau und Immobilien: entdecken Sie die drei Bereiche von Falkenried.' : 'Car servicing, landscaping and property: explore the three areas of Falkenried.'}</p>
      <a class="btn-primary" href="#bereiche">{de ? 'Unsere Bereiche entdecken' : 'Explore our services'} <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="group-hero-image"><Image src={garden} widths={[640, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" alt={de ? 'Gestufte Wasserbecken, umgeben von Bäumen und blühenden Pflanzen' : 'Stepped pools surrounded by trees and flowering plants'} /><figcaption>{de ? 'Garteninspiration für das Falkenried-Konzept' : 'Garden inspiration for the Falkenried concept'}</figcaption></figure>
  </section>
  <section id="bereiche" class="group-divisions group-container">
    <div class="group-section-heading"><h2>{de ? 'Was dürfen wir für Sie tun?' : 'How can we help?'}</h2><p>{de ? 'Wählen Sie Ihren Bereich. Dort finden Sie Leistungen, Einblicke und den passenden Kontakt.' : 'Choose a service to find the details, see examples and try an enquiry.'}</p></div>
    <div class="group-division-grid">{divisions.map(item => <article class="group-division"><a href={routes[item.route][lang]}><Image src={item.image} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" alt={item.alt} /><div class="group-division-body"><p class="group-division-name">{item.name}</p><h3>{item.title}</h3><p>{item.text}</p><span class="group-division-link">{de ? `${item.name} entdecken` : `Explore ${item.name.toLowerCase()}`} <span aria-hidden="true">↗</span></span></div></a></article>)}</div>
  </section>
  <section class="group-about"><div class="group-container group-about-grid"><h2>{de ? 'Drei Bereiche. Ein gemeinsamer Gedanke.' : 'Three services. One shared idea.'}</h2><div><p>{de ? 'Ein Fahrzeug, das Sie im Alltag begleitet. Ein Garten, in dem Sie gerne Zeit verbringen. Räume zum Wohnen oder Arbeiten. Die drei Bereiche verbinden Angebote, die im Alltag zusammengehören.' : 'A car for everyday journeys. A garden you enjoy spending time in. A place to live or work. These three areas bring everyday services together.'}</p><p>{de ? 'Falkenried ist ein fiktives Unternehmen. Das Konzept zeigt, wie Sie sich trotz unterschiedlicher Leistungen auf einer gemeinsamen Website leicht zurechtfinden können.' : 'Falkenried is a fictional business. The concept shows how different services can share a website that is easy to find your way around.'}</p><a class="group-text-link" href={routes.geschichte[lang]}>{de ? 'Die Idee hinter Falkenried' : 'The idea behind Falkenried'} <span aria-hidden="true">→</span></a></div></div></section>
  <section class="contact-invitation"><div class="group-container group-contact"><div><h2>{de ? 'Ihr Anliegen. Der passende Kontakt.' : 'Your question. The right contact.'}</h2><p class="contact-invitation-copy">{de ? 'Wählen Sie einen Bereich und probieren Sie den Anfrageablauf aus.' : 'Choose a service and try the enquiry process.'}</p></div><a class="btn-primary" href={routes.kontakt[lang]}>{de ? 'Demo-Anfrage vorbereiten' : 'Prepare a demo enquiry'} <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
