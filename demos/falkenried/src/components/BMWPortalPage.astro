---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionNav from "./SectionNav.astro";
import ExternalEmbed from "./ExternalEmbed.astro";
import ServiceList from "./ServiceList.astro";
import { Image } from "astro:assets";
import { routes, type Lang } from "../i18n/nav";
import { autolina, bmwServices, stationFeatures } from "../data/bmw";
import { bmwHeroImages } from "../data/bmw-images";

type Kind = "service" | "occasions" | "station" | "accessories";
type Props = { lang: Lang; kind: Kind };
const { lang, kind } = Astro.props;
const hero = bmwHeroImages[kind];
const isDE = lang === "de";
const activeRoute = kind === "service" ? routes.bmwService[lang] : kind === "occasions" ? routes.bmwOccasions[lang] : kind === "station" ? routes.bmwStation[lang] : routes.bmwAccessories[lang];
const navItems = [
  { label: isDE ? "Übersicht" : "Overview", href: routes.bmw[lang] },
  { label: "Service", href: routes.bmwService[lang] },
  { label: isDE ? "Occasionen" : "Used cars", href: routes.bmwOccasions[lang] },
  { label: isDE ? "Servicestation" : "Service station", href: routes.bmwStation[lang] },
  { label: isDE ? "Zubehör" : "Accessories", href: routes.bmwAccessories[lang] },
] as const;
const copy = {
  service: { title: isDE ? "Wartung und Reparatur." : "Maintenance and repairs.", intro: isDE ? "Von der Fehlersuche bis zur Reparatur: Entdecken Sie, welche Arbeiten zum Werkstattangebot gehören." : "From finding a fault to repairing it: explore the work covered by the workshop services." },
  occasions: { title: isDE ? "Occasionen im Überblick." : "Used cars at a glance.", intro: isDE ? "So könnte eine Fahrzeugübersicht aussehen. Diese Demo enthält keine verfügbaren Fahrzeuge oder echten Verkaufsangebote." : "See how a vehicle listing page could work. This demo has no available cars or live sales offers." },
  station: { title: isDE ? "Tanken. Laden. Pflegen." : "Fuel. Charge. Care.", intro: isDE ? "Tanken, Ihr Elektroauto laden oder das Fahrzeug reinigen: Hier finden Sie die Zeiten und Zahlungsmöglichkeiten im Beispiel." : "Refuel, charge your electric car or clean your vehicle. Find the example opening hours and payment options here." },
  accessories: { title: isDE ? "Zubehör für Ihren BMW." : "Accessories for your BMW.", intro: isDE ? "Dachtransport oder Räder für die neue Saison: Die passende Auswahl hängt von Ihrem Fahrzeug und Ihrer Nutzung ab." : "Roof carriers or wheels for the new season: the right choice depends on your car and how you use it." },
}[kind];
---

<BaseLayout lang={lang} route={kind === "service" ? "bmwService" : kind === "occasions" ? "bmwOccasions" : kind === "station" ? "bmwStation" : "bmwAccessories"} title={`${copy.title.replace(/<[^>]+>/g, "")} | Falkenried Gruppe`} description={copy.intro}>
  <section class="portal-hero relative overflow-hidden bg-[#07182d] text-white">
    <div class="absolute inset-0"><Image src={hero.image} alt={hero.alt[lang]} class="h-full w-full object-cover opacity-55" widths={[700, 1100, 1600]} sizes="100vw" loading="eager" fetchpriority="high" /><div class="absolute inset-0 bg-gradient-to-r from-[#07182d] via-[#07182d]/80 to-[#07182d]/20"></div></div>
    <div class="relative mx-auto max-w-[var(--container-max)] px-6 py-24 lg:px-16 lg:py-32">
      
      <h1 class=" max-w-3xl font-display text-4xl font-semibold leading-tight lg:text-6xl">{copy.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-white/90">{copy.intro}</p>
    </div>
  </section>
  <SectionNav label={isDE ? "Werkstattbereich" : "Workshop pages"} items={navItems} activePath={activeRoute} accentVar="--color-bmw-text" />

  {kind === "service" && <section class="bg-[var(--color-surface)] py-[var(--spacing-section-gap)]"><div class="mx-auto max-w-[var(--container-max)] px-6 lg:px-16"><div class="mb-12 flex flex-wrap items-end justify-between gap-6"><div><span class="label-caps text-[var(--color-bmw-text)]">{isDE ? "Werkstattleistungen" : "Workshop services"}</span><h2 class="mt-3 font-display text-3xl font-semibold">{isDE ? "Was Ihre Werkstatt übernehmen kann" : "What the workshop can help with"}</h2></div><a href={routes.kontakt[lang] + (isDE ? "#allgemeine-anfrage" : "#general-inquiry")} class="btn-primary">{isDE ? "Demo-Anfrage öffnen" : "Open demo enquiry"}</a></div><div class="grid gap-6 md:grid-cols-2">{bmwServices.map((service, index) => <article class="card group relative overflow-hidden p-8 service-card"><span class="absolute right-6 top-5 font-display text-5xl text-[#637280]">{String(index + 1).padStart(2, "0")}</span><p class="label-caps text-[var(--color-bmw-text)]">{service.audience?.[lang] ?? "BMW Service"}</p><h3 class="mt-4 font-display text-2xl font-semibold">{service.title[lang]}</h3><p class="mt-3 text-[var(--color-ink-muted)]">{service.summary[lang]}</p>{service.price && <p class="mt-5 text-lg font-semibold">{service.price[lang]}</p>}<ServiceList accentVar="--color-bmw-text" items={service.details[lang]} /><p class="mt-6 text-xs text-[var(--color-ink-muted)]">{isDE ? "Demo-Inhalte und Beispielpreise, kein reales Angebot." : "Demo content and example prices, not a real offer."}</p></article>)}</div></div></section>}

  {kind === "occasions" && <section class="bg-[var(--color-surface)] py-[var(--spacing-section-gap)]"><div class="mx-auto max-w-[var(--container-max)] px-6 lg:px-16"><ExternalEmbed lang={lang} title={isDE ? "Fahrzeugauswahl im Designkonzept" : "Vehicle selection in this design concept"} description={isDE ? "Die Fahrzeugübersicht ist hier als Beispiel dargestellt. Es werden keine externen Angebote geladen." : "The vehicle listing page is shown as an example. No external listings are loaded."} activateLabel={isDE ? "Fahrzeuge anzeigen" : "Show vehicles"} externalLabel={isDE ? "Autolina direkt öffnen" : "Open Autolina directly"} embedUrl={autolina.iframeUrl} externalUrl={autolina.externalUrl} /></div></section>}

  {kind === "station" && <section class="bg-[var(--color-surface-low)] py-[var(--spacing-section-gap)]"><div class="mx-auto max-w-[var(--container-max)] px-6 lg:px-16"><div class="grid gap-6 md:grid-cols-2">{stationFeatures.map((feature) => <article class="card min-w-0 [overflow-wrap:anywhere] border-t-4 border-t-[var(--color-bmw-text)] p-6 sm:p-8"><p class="label-caps text-[var(--color-bmw-text)]">{feature.eyebrow[lang]}</p><h2 class="mt-4 font-display text-3xl font-semibold">{feature.title[lang]}</h2><p class="mt-4 text-[var(--color-ink-muted)]">{feature.description[lang]}</p><dl class="mt-7 space-y-3 border-t border-[var(--color-outline-variant)]/50 pt-5"><div><dt class="text-xs font-semibold uppercase tracking-wider">{isDE ? "Verfügbarkeit" : "Availability"}</dt><dd class="mt-1">{feature.availability[lang]}</dd></div>{feature.payment && <div><dt class="text-xs font-semibold uppercase tracking-wider">{isDE ? "Bezahlung" : "Payment"}</dt><dd class="mt-1">{feature.payment[lang]}</dd></div>}</dl></article>)}</div><p class="mt-8 text-sm text-[var(--color-ink-muted)]">{isDE ? "Waschanlage und Staubsauger sind an Sonn- und Feiertagen geschlossen. Beispielangaben für diese Demo." : "Car wash and vacuum are closed on Sundays and public holidays. Example details for this demo."}</p></div></section>}

  {kind === "accessories" && <section class="bg-[var(--color-surface)] py-[var(--spacing-section-gap)]"><div class="mx-auto grid max-w-[var(--container-max)] gap-8 px-6 md:grid-cols-2 lg:px-16"><article class="card p-10"><span class="label-caps text-[var(--color-bmw-text)]">{isDE ? "FÜR IHREN BMW" : "FOR YOUR BMW"}</span><h2 class="mt-4 font-display text-3xl font-semibold">{isDE ? "Zubehör" : "Accessories"}</h2><p class="mt-4 text-[var(--color-ink-muted)]">{isDE ? "Für einen Dachträger oder eine Dachbox sind Modell, Baujahr und Dachausführung wichtig. Beschreiben Sie im Demoformular, was Sie transportieren möchten und welches Fahrzeug Sie haben." : "Choosing a roof rack or roof box depends on the model, year and roof type. In the demo form, describe your car and what you want to carry."}</p><a href={routes.kontakt[lang]} class="btn-primary mt-8 inline-flex">{isDE ? "Demo-Anfrage zu Zubehör" : "Try an accessories enquiry"}</a></article><article class="card p-10"><span class="label-caps text-[var(--color-bmw-text)]">{isDE ? "SOMMER · WINTER" : "SUMMER · WINTER"}</span><h2 class="mt-4 font-display text-3xl font-semibold">{isDE ? "Kompletträder" : "Wheel and tyre sets"}</h2><p class="mt-4 text-[var(--color-ink-muted)]">{isDE ? "Sommer- und Winterräder werden passend zu Modell und Saison ausgewählt. Die Demo zeigt keine verfügbaren Produkte oder verbindlichen Preise." : "Summer and winter wheel sets need to suit your model and the season. This demo does not list available products or confirmed prices."}</p><a href={routes.kontakt[lang]} class="btn-secondary mt-8 inline-flex">{isDE ? "Demo-Anfrage öffnen" : "Open demo enquiry"}</a></article></div></section>}
</BaseLayout>
