---
import type { Lang } from "../i18n/nav";
import { type FormArea } from "../lib/form-config";

interface SelectField {
  type: "select";
  name: string;
  label: string;
  options: string[];
}
interface TextField {
  type: "text" | "email" | "tel";
  name: string;
  label: string;
  placeholder?: string;
}
interface TextareaField {
  type: "textarea";
  name: string;
  label: string;
  placeholder?: string;
}
type Field = SelectField | TextField | TextareaField;

interface Props {
  lang: Lang;
  area: FormArea;
  source: string;
  objectId?: string;
  subject: string;
  fields: Field[];
  submitLabel: string;
  successMessage: string;
  errorMessage: string;
}

const { lang, subject, fields } = Astro.props;
const demoMessage = lang === "de"
  ? "Demoformular: Sie können die Eingabe ausprobieren. Ihre Daten werden weder übertragen noch gespeichert."
  : "Demo form: Try the interaction. Your details are neither transmitted nor stored.";
const formId = `form-${subject.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<form
  id={formId}
  class="contact-form space-y-8 card p-8 lg:p-12"
>
  <p class="text-sm">{demoMessage} <a href={lang === "de" ? "https://silvandigital.ch/privacy" : "https://silvandigital.ch/en/privacy"} class="underline">{lang === "de" ? "Datenschutz" : "Privacy"}</a></p>
  <noscript><p>{lang === "de" ? "Zum Ausprobieren bitte JavaScript aktivieren. Das Formular bleibt sonst deaktiviert." : "Enable JavaScript to try this form. Otherwise it stays disabled."}</p></noscript>
  <fieldset disabled class="space-y-8 border-0 p-0 m-0 min-w-0" aria-label={lang === "de" ? "Demo-Anfrage" : "Demo enquiry"}>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {fields
      .filter((f) => f.type !== "textarea")
      .map((field) => (
        <div class="relative">
          <label class="label-caps text-[var(--color-ink-muted)] block mb-2" for={`${formId}-${field.name}`}>
            {field.label}
          </label>
          {field.type === "select" ? (
            <select
              id={`${formId}-${field.name}`}
              name={field.name}
              required
              class="w-full border-0 border-b border-[var(--color-outline-variant)] focus:ring-0 focus:border-[var(--color-primary)] px-0 py-3 bg-transparent outline-none appearance-none"
            >
              {(field as SelectField).options.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          ) : (
            <input
              id={`${formId}-${field.name}`}
              type={field.type}
              name={field.name}
              required
              placeholder={(field as TextField).placeholder}
              class="w-full border-0 border-b border-[var(--color-outline-variant)] focus:ring-0 focus:border-[var(--color-primary)] px-0 py-3 bg-transparent outline-none"
            />
          )}
        </div>
      ))}
  </div>

  {fields
    .filter((f) => f.type === "textarea")
    .map((field) => (
      <div class="relative">
        <label class="label-caps text-[var(--color-ink-muted)] block mb-2" for={`${formId}-${field.name}`}>
          {field.label}
        </label>
        <textarea
          id={`${formId}-${field.name}`}
          name={field.name}
          required
          rows="4"
          placeholder={(field as TextareaField).placeholder}
          class="w-full border-0 border-b border-[var(--color-outline-variant)] focus:ring-0 focus:border-[var(--color-primary)] px-0 py-3 bg-transparent outline-none resize-none"
        ></textarea>
      </div>
    ))}

  <button
    type="submit"
    class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50"
  >
    {lang === "de" ? "Demo-Anfrage testen" : "Try demo enquiry"}
  </button>
  </fieldset>
  <p class="form-feedback text-sm hidden" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const feedback = form.querySelector<HTMLElement>(".form-feedback");
      if (feedback) { feedback.textContent = document.documentElement.lang === "de" ? "Vielen Dank! So sieht die Bestätigung aus. Dies ist eine Demo – es wurde nichts versendet oder gespeichert." : "Thank you! This is a demo confirmation. Nothing has been sent or stored."; feedback.classList.remove("hidden"); }
      form.reset();
    });
    // Only accept input once the submit cancellation handler exists.
    const fields = form.querySelector<HTMLFieldSetElement>("fieldset");
    if (fields) fields.disabled = false;
  });
</script>
