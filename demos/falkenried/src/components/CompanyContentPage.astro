---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routes, type Lang } from "../i18n/nav";
import { events, jobs, news, partners } from "../data/company-content";
type Kind = "news" | "events" | "jobs" | "partners";
const { lang, kind } = Astro.props as { lang: Lang; kind: Kind };
const de = lang === "de";
const content = {
  news: { title: de ? "Neues, Tipps und Einblicke." : "News, tips and insights.", intro: de ? "Beispielbeiträge zu Werkstatt, Garten und Unternehmen. So könnte Falkenried Neuigkeiten und nützliche Hinweise teilen." : "Sample posts about the workshop, gardens and the business. See how Falkenried could share news and useful advice." },
  events: { title: de ? "Veranstaltungen und Begegnungen." : "Events and local gatherings.", intro: de ? "Hier hätten Veranstaltungen mit Datum, Ort und Anmeldung ihren Platz. In dieser Demo sind keine Veranstaltungen angekündigt." : "This is where events would appear with dates, locations and registration details. No events are announced in this demo." },
  jobs: { title: de ? "Arbeiten bei Falkenried." : "Working at Falkenried.", intro: de ? "So könnte ein Unternehmen offene Stellen vorstellen. Falkenried ist fiktiv; in dieser Demo gibt es keine Stellenangebote." : "See how a business could present job opportunities. Falkenried is fictional; there are no vacancies in this demo." },
  partners: { title: de ? "Ergänzende Angebote." : "Services that work together.", intro: de ? "Ein Umzug braucht oft mehr als eine neue Wohnung. Zwei fiktive Partnerprofile zeigen, wie Transport und Reinigung das Immobilienangebot ergänzen könnten." : "Moving often involves more than finding a home. Two fictional partner profiles show how transport and cleaning could complement the property services." },
}[kind];
const route = routes[kind][lang];
---
<BaseLayout lang={lang} route={kind} title={`${content.title} | Falkenried Gruppe`} description={content.intro}>
  <section class="bg-[var(--color-primary)] pb-20 pt-40 text-white"><div class="mx-auto max-w-[var(--container-max)] px-6 lg:px-16"><h1 class=" max-w-4xl font-display text-4xl font-semibold lg:text-6xl">{content.title}</h1><p class="mt-6 max-w-2xl text-lg text-white/90">{content.intro}</p></div></section>
  <nav aria-label={de ? "Unternehmensinhalte" : "Company content"} class="border-b border-[var(--color-outline-variant)]/50 bg-[var(--color-surface)]"><div class="mx-auto flex max-w-[var(--container-max)] gap-3 overflow-x-auto px-6 py-4 lg:px-16">{(["news", "events", "jobs", "partners"] as const).map((key) => <a href={routes[key][lang]} aria-current={route === routes[key][lang] ? "page" : undefined} class="shrink-0 rounded-full px-4 py-2 text-sm font-semibold aria-[current=page]:bg-[var(--color-primary)] aria-[current=page]:text-white">{{news:de?"Aktuelles":"News",events:de?"Veranstaltungen":"Events",jobs:"Jobs",partners:de?"Partner":"Partners"}[key]}</a>)}</div></nav>
  <section class="bg-[var(--color-surface-low)] py-[var(--spacing-section-gap)]"><div class="mx-auto max-w-[var(--container-max)] px-6 lg:px-16">
    {kind === "news" && <div class="grid gap-6 md:grid-cols-3">{news.map((item) => <article class="card flex flex-col p-8"><div class="flex items-center justify-between"><span class="label-caps text-[var(--color-primary)]">{item.category[lang]}</span><time datetime={String(item.year)}>{item.year}</time></div><h2 class="mt-6 font-display text-2xl font-semibold">{item.title[lang]}</h2><p class="mt-4 flex-1 text-[var(--color-ink-muted)]">{item.summary[lang]}</p><p class="mt-7 text-sm text-[var(--color-ink-muted)]">{de ? "Beispielbeitrag" : "Sample post"}</p></article>)}</div>}
    {kind === "events" && (events.length ? <div>{events.map((event) => <article><h2>{event.title[lang]}</h2></article>)}</div> : <div class="rounded-xl border border-[var(--color-outline-variant)]/60 bg-[var(--color-surface)] p-10 text-center"><h2 class="font-display text-3xl font-semibold">{de ? "Keine Veranstaltungen in dieser Demo" : "No events in this demo"}</h2><p class="mx-auto mt-4 max-w-xl text-[var(--color-ink-muted)]">{de ? "In diesem Designkonzept sind keine Veranstaltungen geplant. Entdecken Sie stattdessen die Beispielbeiträge aus unseren drei Bereichen." : "No events are planned in this design concept. Explore the sample posts from our three divisions instead."}</p><a href={routes.news[lang]} class="btn-primary mt-8 inline-flex">{de ? "Aktuelles ansehen" : "View news"}</a></div>)}
    {kind === "jobs" && (jobs.length ? <div>{jobs.map((job) => <article><h2>{job.title[lang]}</h2></article>)}</div> : <div class="rounded-xl border border-[var(--color-outline-variant)]/60 bg-[var(--color-surface)] p-10 text-center"><h2 class="font-display text-3xl font-semibold">{de ? "Keine Stellenangebote in dieser Demo" : "No vacancies in this demo"}</h2><p class="mx-auto mt-4 max-w-xl text-[var(--color-ink-muted)]">{de ? "Hier werden keine echten Bewerbungen angenommen. Sie können eine allgemeine Anfrage mit fiktiven Testdaten ausprobieren." : "No real applications are accepted here. You can try a general enquiry using fictional test details."}</p><a href={routes.kontakt[lang] + (de ? "#allgemeine-anfrage" : "#general-inquiry")} class="btn-primary mt-8 inline-flex">{de ? "Demo-Anfrage ausprobieren" : "Try a demo enquiry"}</a></div>)}
    {kind === "partners" && <div class="grid gap-6 md:grid-cols-2">{partners.map((partner) => <article class="card p-9"><span class="label-caps text-[var(--color-realestate)]">{partner.service[lang]}</span><h2 class="mt-4 font-display text-3xl font-semibold">{partner.name}</h2><p class="mt-4 text-[var(--color-ink-muted)]">{partner.description[lang]}</p>{partner.phone && <p class="mt-5 font-semibold">{de ? "Keine reale Telefonnummer in dieser Demo" : "No real phone number in this demo"}</p>}<a href={routes.kontakt[lang]} class="btn-secondary mt-7 inline-flex">{de ? "Demo-Kontakt öffnen" : "Open demo contact"}</a></article>)}</div>}
  </div></section>
</BaseLayout>
