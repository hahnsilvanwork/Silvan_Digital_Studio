---
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
const gridColumns = steps.length === 3
  ? "sm:grid-cols-3 lg:grid-cols-3"
  : "sm:grid-cols-2 lg:grid-cols-4";
---

<div class:list={["grid grid-cols-1 gap-8", gridColumns]}>
  {steps.map((step) => (
    <div class="flex flex-col items-center text-center">
      <span class="w-10 h-10 rounded-full bg-[var(--color-primary)] text-white flex items-center justify-center font-bold mb-5">
        {step.number}
      </span>
      <h3 class="font-semibold mb-2">{step.title}</h3>
      <p class="max-w-sm text-sm text-[var(--color-ink-muted)] leading-relaxed">{step.description}</p>
    </div>
  ))}
</div>
