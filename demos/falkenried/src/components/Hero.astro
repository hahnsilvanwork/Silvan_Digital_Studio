---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  variant?: "split" | "full";
  eyebrow: string;
  title: string; // may include a <span class="italic ..."> accent
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  floatingBadge?: string;
}

const {
  variant = "split",
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt,
  primaryCta,
  secondaryCta,
  floatingBadge,
} = Astro.props;
---

{variant === "split" ? (
  <section class="relative min-h-[85vh] flex items-center pt-32 pb-16 bg-white overflow-hidden">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <span class="label-caps text-[var(--color-primary)] mb-6 block">{eyebrow}</span>
        <h1 class="font-display text-4xl lg:text-6xl font-bold mb-8 leading-[1.05]" set:html={title} />
        <p class="text-lg text-[var(--color-ink-muted)] mb-10 max-w-xl leading-relaxed">{subtitle}</p>
        <div class="flex flex-wrap gap-8">
          <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
          )}
        </div>
      </div>
      <div class="lg:col-span-5 relative mt-10 lg:mt-0">
        <div class="aspect-[4/5] rounded-xl overflow-hidden">
          <Image src={image} alt={imageAlt} class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(min-width: 1024px) 40vw, 90vw" />
        </div>
        {floatingBadge && (
          <div class="absolute -bottom-8 -left-8 w-40 h-40 bg-[var(--color-primary)] rounded-lg items-center justify-center text-white p-6 hidden xl:flex">
            <p class="text-center label-caps text-[10px] leading-relaxed">{floatingBadge}</p>
          </div>
        )}
      </div>
    </div>
  </section>
) : (
  <section class="image-hero relative min-h-[70vh] flex items-end pt-32 pb-16 overflow-hidden">
    <Image src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" widths={[640, 1200, 1800]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero-contrast-overlay absolute inset-0"></div>
    <div class="relative max-w-[var(--container-max)] mx-auto px-6 lg:px-16 w-full text-white">
      <span class="label-caps text-white/90 mb-6 block">{eyebrow}</span>
      <h1 class="font-display text-4xl lg:text-6xl font-bold mb-6 max-w-3xl leading-[1.05]" set:html={title} />
      <p class="text-lg text-white/95 mb-10 max-w-xl leading-relaxed">{subtitle}</p>
      <div class="flex flex-wrap gap-6">
        <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
        )}
      </div>
    </div>
  </section>
)}
