---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Hero from "../components/Hero.astro";
import DivisionCard from "../components/DivisionCard.astro";
import VideoPreview from "../components/VideoPreview.astro";
import Testimonial from "../components/Testimonial.astro";
import { routes } from "../i18n/nav";
import { organizationSchema } from "../lib/schema";
import heroImage from "../assets/images/garden/garden-path.jpg";

const lang = "de";
---

<BaseLayout
  lang={lang}
  route="home"
  title="Falkenried Gruppe | Autowerkstatt, Gartenbau & Immobilien im Zürcher Unterland"
  description="Fiktives Unternehmensporträt: Fahrzeugservice, Gartenbau und Immobilien im Zürcher Unterland. Die Beispielgeschichte der Falkenried Gruppe beginnt 1969."
  jsonLd={organizationSchema(lang)}
>
  <section class="falkenried-hero">
    <div class="hero-copy">
      <span class="label-caps hero-eyebrow">FALKENRIED GRUPPE · ZÜRCHER UNTERLAND</span>
      <h1>Für das Leben.<br /><em>Für morgen.</em></h1>
      <p>Wir bringen Sie weiter. Schaffen Raum zum Ankommen. Und lassen Lieblingsplätze wachsen.</p>
      <div class="hero-actions"><a href="#bereiche" class="btn-primary">Unsere Bereiche entdecken <span aria-hidden="true">↗</span></a><a href={routes.kontakt[lang]} class="hero-text-link">Persönlich ins Gespräch →</a></div>
      <div class="hero-signature"><span>03</span><p>Bereiche. Ein Anspruch.<br /><strong>Qualität, die bleibt.</strong></p></div>
    </div>
    <div class="hero-visual"><Image src={heroImage} alt="Grüner Gartenweg als einladender Rückzugsort" widths={[640,1000,1400]} sizes="(min-width: 1024px) 52vw, 100vw" loading="eager" fetchpriority="high" /><span class="hero-image-note">RAUM FÜR DAS, WAS ZÄHLT.</span><span class="hero-seal">F.<small>MIT SORGFALT.<br />MIT WEITBLICK.</small></span></div>
  </section>

  <section id="bereiche" class="border-y border-[var(--color-outline-variant)]/30 py-16 bg-[var(--color-surface-lowest)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="sr-only">Unsere drei Geschäftsbereiche</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 md:divide-x divide-[var(--color-outline-variant)]/40">
        <DivisionCard
          index="01 / MOBILITÄT"
          accentVar="--color-bmw-text"
          title="Autowerkstatt"
          description="Pers?nlicher Fahrzeugservice, Wartung und Beratung aus einer Hand."
          href={routes.bmw[lang]}
        />
        <DivisionCard
          index="02 / NATUR"
          accentVar="--color-garden"
          title="Gartenbau"
          description="Meisterhafte Gestaltung und Pflege für Ihren privaten Rückzugsort."
          href={routes.gartenbau[lang]}
        />
        <DivisionCard
          index="03 / WOHNEN"
          accentVar="--color-realestate"
          title="Immobilien"
          description="Exklusives Wohnen und professionelle Verwaltung eigener Objekte."
          href={routes.immobilien[lang]}
        />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="mb-10 text-center">
        <span class="label-caps text-[var(--color-primary)] mb-4 block">FALKENRIED GRUPPE IM PORTRÄT</span>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold">Persönlich. Vielseitig. Seit 1969.</h2>
      </div>
      <VideoPreview lang="de" />

      <div class="mt-20">
        <div class="mb-12 text-center">
          <span class="label-caps text-[var(--color-primary)] mb-4 block">BEISPIELSTIMMEN · DEMO</span>
          <h2 class="font-display text-3xl font-semibold">So könnte sich guter Service anfühlen</h2>
        </div>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
          <Testimonial quote="Professionell, freundlich, zuverlässig. Die Anliegen werden ernst genommen und Lösungen gefunden." name="H. B. aus Nassenwil" role="Beispielstimme" />
          <Testimonial quote="Top Beratung – der Kunde im Vordergrund, einfach übersichtlich." name="J. W. aus Bachs" role="Beispielstimme" />
          <Testimonial quote="Sehr nette und kompetente Mitarbeiter, fühle mich sehr wohl und komme gerne. Sehr kundenorientiert, super – weiter so." name="C. H. aus Schleinikon" role="Beispielstimme" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16 text-center">
      <span class="label-caps text-[var(--color-primary)] mb-6 block">UNSERE GESCHICHTE</span>
      <h2 class="font-display text-3xl lg:text-4xl font-semibold italic font-light mb-8">Seit 1969 gewachsen.</h2>
      <p class="text-lg text-[var(--color-ink-muted)] leading-relaxed mb-10">
        Was 1969 als lokale Werkstatt im Zürcher Unterland begann, ist heute ein modernes Familienunternehmen in
        zweiter Generation – mit drei starken Standbeinen und tiefen Wurzeln im Zürcher Unterland.
      </p>
      <a href={routes.geschichte[lang]} class="btn-secondary">Unsere Geschichte entdecken</a>
    </div>
  </section>

  <section id="kontakt-einstieg" class="contact-invitation">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-semibold mb-6">Bereit für den nächsten Schritt?</h2>
      <p class="contact-invitation-copy max-w-xl mx-auto mb-10 leading-relaxed">
        Probieren Sie eine Werkstatt-, Garten- oder Mietanfrage im Demoformular aus. Ihre Eingaben werden nicht gesendet; es erfolgt keine Rückmeldung.
      </p>
      <a href={routes.kontakt[lang]} class="btn-primary">Kontaktformular öffnen</a>
    </div>
  </section>
</BaseLayout>
