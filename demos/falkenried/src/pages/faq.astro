---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqTabs from "../components/FaqTabs.astro";
import { routes, common } from "../i18n/nav";
import { organizationSchema, faqSchema } from "../lib/schema";
import { bmwFaqs } from "../data/bmw";

const lang = "de";
const c = common[lang];

const groups = [
  {
    key: "bmw",
    label: "Autowerkstatt",
    items: [
      ...bmwFaqs.map((item) => ({ question: item.question.de, answer: item.answer.de })),
      { question: "Welche Angaben helfen bei einer Serviceanfrage?", answer: "Nennen Sie das Modell, den Kilometerstand und die gewünschten Arbeiten. Bei einer Störung hilft eine kurze Beschreibung: Was fällt Ihnen auf und wann tritt es auf?" },
      { question: "Enthält das Beispiel verbindliche Garantiezusagen?", answer: "Nein. Herstellerpartnerschaften, Garantien und die Deckung eines Servicepakets werden durch diese Demo nicht bestätigt. Bei einem echten Auftrag müssten diese Punkte für das jeweilige Fahrzeug geklärt werden." },
      { question: "Wie kann ich einen Bedarf an Ersatzmobilität angeben?", answer: "Erwähnen Sie in Ihrer Beispielanfrage, ob Sie während der Reparatur ein Fahrzeug benötigen. Das Formular zeigt diesen Wunsch in der Zusammenfassung. Es reserviert keinen Ersatzwagen." },
      { question: "Welche Servicearbeiten zeigt die Website?", answer: "Die Serviceseite erklärt unter anderem Feriencheck, Klimaservice, Frontscheibenreparaturen und Arbeiten bei Blechschäden. Die Beschreibungen helfen Ihnen, Ihr Anliegen dem passenden Thema zuzuordnen." },
      { question: "Welche Angebote gehören zur Servicestation?", answer: "Das Beispiel umfasst eine Selbstbedienungstankstelle, zwei Ladepunkte, Waschplätze und einen Staubsauger. Tanken und Laden sind mit 24-Stunden-Zugang dargestellt. Für Waschanlage und Staubsauger gelten eigene Zeiten." },
    ],
  },
  {
    key: "gartenbau",
    label: "Gartenbau",
    items: [
      { question: "Für welche Region ist das Gartenbaukonzept gedacht?", answer: "Das Zürcher Unterland bildet den regionalen Rahmen dieses Unternehmensbeispiels. Diese Angabe beschreibt die Demo und kein tatsächliches Einsatzgebiet." },
      { question: "Was sollte ich bei der Planung einer Umgestaltung beachten?", answer: "Überlegen Sie zuerst, wie Sie den Garten nutzen möchten und wie viel Pflege zu Ihnen passt. Für viele Pflanzarbeiten bieten Frühling und Herbst günstige Bedingungen. Boden, Standort und Pflanzenart spielen ebenfalls eine Rolle." },
      { question: "Welche Arbeiten gehören zum Gartenunterhalt?", answer: "Die Übersicht nennt Rasenpflege, Schnittarbeiten, Bepflanzung, Rosenpflege und weitere saisonale Aufgaben. Für eine Beispielanfrage sind Gartengrösse, Bepflanzung und die gewünschten Arbeiten hilfreich." },
      { question: "Was kann ich in einer Gartenanfrage beschreiben?", answer: "Zum Beispiel einen neuen Sitzplatz, Wege, Mauern, einen Brunnen oder eine andere Bepflanzung. Beschreiben Sie den vorhandenen Garten, Ihre Wünsche und den ungefähren Zeitraum." },
    ],
  },
  {
    key: "immobilien",
    label: "Immobilien",
    items: [
      { question: "Welche Immobilien zeigt die Website?", answer: "Die Immobilienseite zeigt beispielhafte Wohn- und Gewerberäume mit Musterangaben zu Lage, Grösse und Miete. Es handelt sich um keine verfügbaren Mietangebote." },
      { question: "Wo finde ich die Angaben zu einem Objekt?", answer: "Die Objektkarten enthalten die wichtigsten Beispielangaben. Über den Link zur Demo-Anfrage wird das gewählte Objekt im Formular vorausgewählt." },
      { question: "Sind die gezeigten Mietpreise verbindlich?", answer: "Nein. Die Preise sind Musterwerte für dieses Designkonzept. Es gibt weder ein Mietangebot noch eine Vereinbarung zu Kaution, Nebenkosten oder weiteren Vertragsbedingungen." },
      { question: "Kann ich eine Wohnung reservieren oder eine Besichtigung buchen?", answer: "Nein. Sie können eine Demo-Anfrage ausfüllen und prüfen. Sie wird nicht gesendet und löst weder eine Reservierung noch eine Besichtigung aus." },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  route="faq"
  title="Häufige Fragen | Falkenried Gruppe"
  description="Antworten zu den Beispielangeboten für Autowerkstatt, Gartenbau und Immobilien sowie zur Nutzung der Falkenried Demo."
  jsonLd={[organizationSchema(lang), faqSchema(groups.flatMap((g) => g.items))]}
>
  <section class="pt-40 pb-20 bg-[var(--color-surface)] text-center">
    <div class="max-w-2xl mx-auto px-6 lg:px-16">
      <h1 class="font-display text-4xl font-bold mb-6">Häufig gestellte Fragen</h1>
      <p class="text-[var(--color-ink-muted)] leading-relaxed">
        Hier finden Sie Antworten zu Autowerkstatt, Gartenbau und Immobilien. Wählen Sie den Bereich,
        der zu Ihrem Anliegen passt.
      </p>
    </div>
  </section>

  <section class="pb-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <FaqTabs groups={groups} />
    </div>
  </section>

  <section class="py-20 bg-[var(--color-surface-low)]">
    <div class="max-w-2xl mx-auto px-6 lg:px-16 text-center">
      <h2 class="font-display text-2xl font-semibold mb-4">Noch Fragen?</h2>
      <p class="text-[var(--color-ink-muted)] mb-8 leading-relaxed">
        Probieren Sie aus, wie sich ein Anliegen im Kontaktformular beschreiben lässt. Die Demo zeigt Ihnen Ihre Angaben als Zusammenfassung.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href={routes.kontakt[lang]} class="btn-primary">Demo-Anfrage ausprobieren</a>
        <a href={c.phoneHref} class="btn-secondary">Demo-Hinweis lesen</a>
      </div>
    </div>
  </section>
</BaseLayout>
