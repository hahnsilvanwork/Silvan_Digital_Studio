---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceList from "../components/ServiceList.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Testimonial from "../components/Testimonial.astro";
import ContactForm from "../components/ContactForm.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import SectionNav from "../components/SectionNav.astro";
import { Image } from "astro:assets";
import { routes } from "../i18n/nav";
import { people } from "../data/company";
import { organizationSchema } from "../lib/schema";
import heroImage from "../assets/images/garden/garden-aerial.jpg";
import pathImage from "../assets/images/garden/garden-path.jpg";
import hedgeImage from "../assets/images/garden/hedge-work.jpg";

const lang = "de";
const accent = "--color-garden" as const;
---

<BaseLayout
  lang={lang}
  route="gartenbau"
  title="Gartenbau | Gestaltung und Unterhalt | Falkenried Gruppe"
  description="Gartengestaltung, Unterhalt und Transporte im Falkenried-Konzept. Entdecken Sie Gartenideen und probieren Sie eine Projektanfrage aus."
  jsonLd={organizationSchema(lang)}
>
  <Hero
    variant="full"
    eyebrow="LANDSCHAFTSGESTALTUNG & PFLEGE"
    title={`Ihr Garten. <span class="italic font-light">Ihr Lieblingsplatz.</span>`}
    subtitle="Ein neuer Sitzplatz, eine passende Bepflanzung oder regelmässige Pflege: Entdecken Sie, wie ein Garten zu Ihren Wünschen und Ihrem Alltag passen kann."
    image={heroImage}
    imageAlt="Geometrisch geschnittene Hecken vor einem historischen Gebäude"
    primaryCta={{ label: "Demo-Projektanfrage", href: routes.kontakt[lang] }}
    secondaryCta={{ label: "Leistungen ansehen", href: "#expertise" }}
  />
  <SectionNav label="Gartenbau: weitere Themen" activePath={routes.gartenbau[lang]} accentVar="--color-garden" items={[
    { label: "Übersicht", href: routes.gartenbau[lang] }, { label: "Gestaltung", href: routes.gardenDesign[lang] },
    { label: "Unterhalt", href: routes.gardenMaintenance[lang] }, { label: "Mulden & Transporte", href: routes.gardenTransport[lang] },
    { label: "Gartenideen", href: routes.gardenReferences[lang] }, { label: "Tipps", href: routes.gardenTips[lang] },
  ]} />

  <section id="expertise" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Gartengestaltung und Planung</span>
        <h2 class="font-display text-3xl font-semibold mb-8">Individuelle Gartenplanung</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
          Wie möchten Sie Ihren Garten nutzen? Ein Sitzplatz, neue Wege oder ein Wasserspiel brauchen
          eine Planung, die Wünsche, Gelände und Bepflanzung zusammenbringt.
        </p>
        <ServiceList accentVar={accent} items={["Planung und Neuanlage", "Wege, Mauern und Sitzplätze", "Wasserspiele und Erdarbeiten"]} />
      </div>
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Gartenpflege & Unterhalt</span>
        <h2 class="font-display text-3xl font-semibold mb-8">Ein Garten, der gepflegt bleibt</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
          Rasen, Hecken und Beete brauchen zu unterschiedlichen Zeiten Aufmerksamkeit.
          Saisonale Arbeiten und regelmässige Pflege helfen, den Garten in Form zu halten.
        </p>
        <ServiceList accentVar={accent} items={["Saisonaler Schnitt & Gehölzpflege", "Rasenpflege & Pflanzenschutz", "Ganzjahresbetreuung & Winterschutz"]} />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <h2 class="font-display text-3xl font-semibold italic font-light">So könnte Ihr Gartenprojekt entstehen</h2>
      </div>
      <ProcessSteps
        steps={[
          { number: "1", title: "Beratung", description: "Wünsche, Gartengrösse und die vorhandenen Bedingungen gemeinsam besprechen." },
          { number: "2", title: "Konzeption", description: "Den Aufbau, die Materialien und die Bepflanzung aufeinander abstimmen." },
          { number: "3", title: "Umsetzung", description: "Die geplanten Arbeiten und den zeitlichen Ablauf vor dem Baustart vereinbaren." },
          { number: "4", title: "Begleitung", description: "Festlegen, welche Pflege der Garten braucht und wer sie übernimmt." },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="grid grid-cols-2 gap-4">
        <div class="aspect-square rounded-lg overflow-hidden">
          <Image src={pathImage} alt="Gartenanlage mit Wasserspiel und Bepflanzung" class="w-full h-full object-cover" widths={[300, 600]} sizes="300px" />
        </div>
        <div class="aspect-square rounded-lg overflow-hidden mt-10">
          <Image src={hedgeImage} alt="Blühende Rosen und Stauden im Garten" class="w-full h-full object-cover" widths={[300, 600]} sizes="300px" />
        </div>
      </div>
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>UNSERE PHILOSOPHIE</span>
        <h2 class="font-display text-3xl font-semibold mb-8">Ein Garten für Ihren Alltag</h2>
        <p class="text-lg text-[var(--color-ink-muted)] mb-10 leading-relaxed">
          Ein Garten soll nicht nur schön aussehen. Er soll Platz für das bieten, was Ihnen wichtig ist:
          draussen essen, mit der Familie Zeit verbringen oder einfach zur Ruhe kommen. Nutzung und Pflege gehören deshalb von Anfang an zur Planung.
        </p>
        <Testimonial
          accentVar={accent}
          quote="Der Garten soll zu den Menschen passen, die ihn nutzen."
          name="Leitgedanke"
          role="Gartenkonzept"
        />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Projekt anfragen</span>
        <h2 class="font-display text-3xl font-semibold mb-6">Ihre Projektidee ausprobieren</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed">
          Beschreiben Sie ein Beispielprojekt und sehen Sie Ihre Angaben in einer Übersicht. Verwenden Sie erfundene Testdaten. Es wird nichts versendet und kein Beratungstermin vereinbart.
        </p>
      </div>
      <ContactForm
        lang={lang}
        area="garden"
        source="/gartenbau/"
        subject="Neue Anfrage – Gartenbau"
        submitLabel="Demo-Anfrage prüfen"
        successMessage="Ihre Beispielangaben sind bereit zur Prüfung. Es wurde nichts versendet."
        errorMessage="Bitte prüfen Sie die markierten Angaben."
        fields={[
          { type: "text", name: "name", label: "Vorname und Nachname", placeholder: "Erika Muster" },
          { type: "email", name: "email", label: "E-Mail-Adresse", placeholder: "erika@beispiel.ch" },
          { type: "select", name: "interesse", label: "Ihr Anliegen", options: ["Neugestaltung & Planung", "Gartenunterhalt", "Beides / Unsicher"] },
          { type: "textarea", name: "message", label: "Nachricht", placeholder: "Wie können wir Ihnen helfen?" },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-10 text-center">Häufige Fragen</h2>
      <FaqAccordion
        items={[
          { question: "Wann ist der beste Zeitpunkt für eine Umgestaltung?", answer: "Frühling und Herbst bieten für viele Pflanzarbeiten günstige Bedingungen. Welche Zeit passt, hängt von Boden, Standort und Pflanzen ab. Die Planung lässt sich davon getrennt angehen." },
          { question: "Bieten Sie auch regelmässigen Unterhalt an?", answer: "Im Beispielangebot finden Sie Rasenpflege, Schnitt, Bepflanzung und weitere Gartenarbeiten. Einmalige Einsätze und regelmässiger Unterhalt würden nach Bedarf vereinbart." },
        ]}
      />
      <div class="text-center mt-10">
        <a href={routes.faq[lang]} class="label-caps" style={`color: var(${accent})`}>Alle Fragen ansehen →</a>
      </div>
    </div>
  </section>
</BaseLayout>
