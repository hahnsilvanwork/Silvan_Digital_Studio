---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { routes } from "../i18n/nav";
import { organizationSchema } from "../lib/schema";
import { company, externalLinks, people } from "../data/company";

const lang = "de";
const divisions = [
  {
    name: "Autowerkstatt",
    person: "jonas-lindberg",
    accent: "--color-bmw-text",
    description: "Service & Verkauf",
    cta: "Termin vereinbaren",
    href: externalLinks.bmwAppointment,
  },
  {
    name: "Gartenbau",
    person: "lukas-falkenried",
    accent: "--color-garden",
    description: "Planung & Pflege",
    cta: "Beratung anfordern",
    href: "#allgemeine-anfrage",
  },
  {
    name: "Immobilien",
    person: "mara-linden",
    accent: "--color-realestate",
    description: "Vermietung & Verwaltung",
    cta: "Objekte ansehen",
    href: routes.immobilien[lang],
  },
] as const;
---

<BaseLayout
  lang={lang}
  route="kontakt"
  title="Kontakt | Falkenried Gruppe in Zürcher Unterland"
  description="Kontaktieren Sie Falkenried Gruppe: Autowerkstatt, Gartenbau und Immobilien in Zürcher Unterland. Keine reale Telefonvermittlung in dieser Demo."
  jsonLd={organizationSchema(lang)}
>
  <section class="pt-40 pb-16 bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <span class="label-caps text-[var(--color-primary)] mb-4 block">TRADITION TRIFFT MODERNE</span>
      <h1 class="font-display text-4xl font-bold mb-6 max-w-2xl">Kontaktieren Sie uns</h1>
      <p class="text-lg text-[var(--color-ink-muted)] max-w-xl leading-relaxed">
        Ob es um die Wartung Ihres BMWs, die Neugestaltung Ihres Gartens oder die Suche nach einer erstklassigen
        Immobilie geht – unsere Experten stehen Ihnen mit Rat und Tat zur Seite.
      </p>
    </div>
  </section>

  <section class="pb-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <h2 class="sr-only">Ihre Ansprechpartner nach Bereich</h2>
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {divisions.map((division) => (
        <div class="card p-8 border-t-4" style={`border-top-color: var(${division.accent})`}>
          <h3 class="font-display text-xl font-semibold mb-1">{division.name}</h3>
          <p class="text-sm text-[var(--color-ink-muted)] mb-6">{division.description}</p>
          <p class="text-sm font-semibold mb-1">{people[division.person].name}</p>
          <p class="text-xs text-[var(--color-ink-muted)] mb-6">{people[division.person].roles[lang].join(" · ")}</p>
          <p class="text-sm mb-6">
            <a href={company.phone.href} class="block hover:text-[var(--color-primary)]">{company.phone.display}</a>
            <a href={`/kontakt/#allgemeine-anfrage`} class="block hover:text-[var(--color-primary)]">{company.email}</a>
          </p>
          <a href={division.href} class="btn-primary w-full" style={`background-color: var(${division.accent})`}>
            {division.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section id="allgemeine-anfrage" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-2xl font-semibold mb-6">Allgemeine Anfrage</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-10">
          Nutzen Sie unser Formular für allgemeine Anliegen oder wenn Sie sich unsicher sind, welcher
          Fachbereich Ihr Ansprechpartner ist. Nutzen Sie nur fiktive Testdaten: Die Demo sendet nichts und löst keine Rückmeldung aus.
        </p>
        <div class="space-y-6 text-sm">
          <div>
            <p class="label-caps text-[var(--color-ink-muted)] mb-2">Hauptsitz</p>
            <p>{company.address.street}, {company.address.postalCode} {company.address.locality}</p>
          </div>
          <div>
            <p class="label-caps text-[var(--color-ink-muted)] mb-2">Telefon</p>
            <a href={company.phone.href} class="hover:text-[var(--color-primary)]">{company.phone.display}</a>
          </div>
          <div>
            <p class="label-caps text-[var(--color-ink-muted)] mb-2">Fax</p>
            <p>{company.fax.display}</p>
          </div>
          <div>
            <p class="label-caps text-[var(--color-ink-muted)] mb-2">E-Mail</p>
            <a href={`/kontakt/#allgemeine-anfrage`} class="hover:text-[var(--color-primary)]">{company.email}</a>
          </div>
        </div>
      </div>
      <div class="lg:col-span-8">
        <ContactForm
          lang={lang}
          area="general"
          source="/kontakt/"
          subject="Allgemeine Anfrage – Kontaktformular"
          submitLabel="Nachricht senden"
          successMessage="Danke für Ihre Nachricht! Wir melden uns in Kürze."
          errorMessage="Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut oder rufen Sie uns an."
          fields={[
            { type: "text", name: "name", label: "Name", placeholder: "Ihren Namen eingeben" },
            { type: "email", name: "email", label: "E-Mail", placeholder: "email@beispiel.ch" },
            { type: "select", name: "betreff", label: "Betreff", options: ["Allgemeine Information", "Autowerkstatt", "Gartenbau", "Immobilien"] },
            { type: "textarea", name: "message", label: "Nachricht", placeholder: "Wie können wir Ihnen helfen?" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="py-20 bg-[var(--color-primary)] text-white text-center">
    <div class="max-w-xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-4">Haben Sie schnelle Fragen?</h2>
      <p class="text-white/70 mb-8 leading-relaxed">
        Besuchen Sie unsere FAQ-Seite für sofortige Antworten auf die häufigsten Fragen zu unseren Dienstleistungen.
      </p>
      <a href={routes.faq[lang]} class="btn-secondary !border-white !text-white hover:!bg-white hover:!text-[var(--color-primary)]">Zu den FAQs →</a>
    </div>
  </section>
</BaseLayout>
