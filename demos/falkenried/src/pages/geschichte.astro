---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactPerson from "../components/ContactPerson.astro";
import { routes } from "../i18n/nav";
import heroImage from "../assets/images/bmw/workshop-lift.jpg";
import { people } from "../data/company";

const lang = "de";
const values = [{"title": "Persönlich", "text": "Klare Ansprechpersonen helfen dabei, ein Anliegen schnell dem passenden Bereich zuzuordnen."}, {"title": "Verständlich", "text": "Leistungen, nächste Schritte und wichtige Angaben sollen auf einen Blick nachvollziehbar sein."}, {"title": "Regional gedacht", "text": "Das Zürcher Unterland bildet den Rahmen für ein Konzept mit kurzen Wegen und alltagsnahen Angeboten."}];
const divisions = [{"number": "01", "title": "Mobilität", "text": "Eine Werkstatt mit übersichtlichen Leistungen für Wartung, Reparatur und Fahrzeugpflege."}, {"number": "02", "title": "Garten", "text": "Gärten gestalten, pflegen und passende Transporte organisieren."}, {"number": "03", "title": "Immobilien", "text": "Eine klare Übersicht zu Mietobjekten und ein direkter Weg zur passenden Anfrage."}];
const contacts = [{"title": "Autowerkstatt & Service", "keys": ["jonas-lindberg"], "accent": "--color-bmw-text"}, {"title": "Gartenbau & Unterhalt", "keys": ["lukas-falkenried"], "accent": "--color-garden"}, {"title": "Immobilien & Verwaltung", "keys": ["mara-linden", "nora-feldmann"], "accent": "--color-realestate"}] as const;
---
<BaseLayout lang={lang} route="geschichte" title="Über das Konzept | Falkenried Gruppe" description="Drei Bereiche, ein gemeinsamer Auftritt: die Idee hinter dem fiktiven Falkenried Unternehmenskonzept.">
  <Hero variant="full" title={"Drei Bereiche. <span class=\"italic font-light\">Eine gemeinsame Idee.</span>"} subtitle="Falkenried ist ein fiktives Unternehmen im Zürcher Unterland. Dieses Designkonzept verbindet Autowerkstatt, Gartenbau und Immobilien in einem gemeinsamen Auftritt." image={heroImage} imageAlt="Klassischer BMW bei einer Fahrzeugausstellung" primaryCta={{ label: "Autowerkstatt entdecken", href: routes.bmw[lang] }} secondaryCta={{ label: "Unsere Leitgedanken", href: '#zeitreise' }} />

  <section id="zeitreise" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-10">Was die Bereiche verbindet</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => <article class="border-l-2 border-[var(--color-primary)] pl-6"><h3 class="font-semibold text-xl mb-3">{value.title}</h3><p class="text-[var(--color-ink-muted)] leading-relaxed">{value.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-10">So ist das Konzept aufgebaut</h2>
      <div class="grid gap-8 md:grid-cols-3">{divisions.map((division, index) => <article><h3 class="font-display text-2xl font-semibold mb-4"><a class="hover:underline underline-offset-4" href={[routes.bmw[lang], routes.gartenbau[lang], routes.immobilien[lang]][index]}>{division.title}</a></h3><p class="text-[var(--color-ink-muted)] leading-relaxed">{division.text}</p></article>)}</div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-5">Ansprechpersonen im Konzept</h2>
      <p class="max-w-2xl text-[var(--color-ink-muted)] mb-12">Die folgenden Namen und Rollen sind fiktive Beispiele für die Zuordnung von Anfragen.</p>
      <div class="grid gap-10 lg:grid-cols-3">{contacts.map((group) => <div><h3 class="font-semibold text-lg mb-6">{group.title}</h3><div class="grid gap-6">{group.keys.map((key) => <ContactPerson name={people[key].name} roles={people[key].roles[lang]} accentVar={group.accent} />)}</div></div>)}</div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-inverse-surface)] text-white text-center">
    <div class="max-w-2xl mx-auto px-6"><h2 class="font-display text-3xl font-semibold mb-6">Eine Anfrage ausprobieren</h2><p class="text-white/85 mb-10 leading-relaxed">Wählen Sie einen Bereich, tragen Sie erfundene Testdaten ein und prüfen Sie die Zusammenfassung.</p><a href={routes.kontakt[lang]} class="btn-primary">Demo-Anfrage öffnen</a></div>
  </section>
</BaseLayout>
