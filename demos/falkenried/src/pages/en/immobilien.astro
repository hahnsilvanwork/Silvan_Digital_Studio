---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import PropertyFilter from "../../components/PropertyFilter.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import ContactPerson from "../../components/ContactPerson.astro";
import ContactForm from "../../components/ContactForm.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { routes } from "../../i18n/nav";
import { realEstateSchema } from "../../lib/schema";
import { people } from "../../data/company";
import heroImage from "../../assets/images/immobilien/apartment-living-1.jpg";
import apartmentImg from "../../assets/images/immobilien/apartment-living-2.jpg";
import officeImg from "../../assets/images/immobilien/office-glass.jpg";
import parkingImg from "../../assets/images/immobilien/parking-garage.jpg";

const lang = "en";
const accent = "--color-realestate" as const;
---

<BaseLayout
  lang={lang}
  route="immobilien"
  title="Property | Apartments, commercial space and parking | Falkenried Gruppe"
  description="Example properties in the Falkenried concept: apartments, commercial spaces and parking. Filter the listings and try a property enquiry."
  jsonLd={realEstateSchema(lang)}
>
  <Hero
    variant="full"
    eyebrow="PROPERTY OVERVIEW"
    title={`A place to live. <span class="italic font-light">Room to work.</span>`}
    subtitle="Apartments, commercial spaces and parking: explore the example properties and try a demo enquiry."
    image={heroImage}
    imageAlt="Modern living space with large windows"
    primaryCta={{ label: "View properties", href: "#objekte" }}
    secondaryCta={{ label: "How the enquiry works", href: "#mietprozess" }}
  />

  <section id="objekte" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="mb-10">
        <span class="label-caps mb-4 block" style={`color: var(${accent})`}>Example properties</span>
        <h2 class="font-display text-3xl font-semibold">Apartments, commercial spaces and parking</h2>
      </div>
      <PropertyFilter
        gridId="property-grid"
        filters={[
          { key: "all", label: "All" },
          { key: "wohnungen", label: "Apartments" },
          { key: "gewerbe", label: "Commercial" },
          { key: "parkplatz", label: "Parking" },
        ]}
      />
      <div id="property-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <PropertyCard
          image={apartmentImg}
          imageAlt="Bright living room illustrating an example apartment"
          status="On request"
          statusTone="neutral"
          category="wohnungen"
          title="Apartment, Zürcher Unterland Chlupf"
          address="Example location in the Zürcher Unterland"
          price="Price on request"
          priceLabel="Monthly rent"
          detailsLabel="Try an enquiry"
        />
        <PropertyCard
          image={officeImg}
          imageAlt="Modern office illustrating an example commercial space"
          status="On request"
          statusTone="neutral"
          category="gewerbe"
          title="Commercial space, Steinbruggstrasse"
          address="Example location near a station in the Zürcher Unterland"
          price="Price on request"
          priceLabel="Monthly rent"
          detailsLabel="Try an enquiry"
        />
        <PropertyCard
          image={parkingImg}
          imageAlt="Underground car park illustrating an example parking space"
          status="On request"
          statusTone="neutral"
          category="parkplatz"
          title="Underground parking space"
          address="Zürcher Unterland Chlupf"
          price="Price on request"
          priceLabel="Monthly rent"
          detailsLabel="Try an enquiry"
        />
      </div>
      <p class="text-sm text-[var(--color-ink-muted)] mt-8">
        These properties and prices are part of the design concept. No spaces are actually offered for rent. Choose “Try an enquiry” to take the selected property into the form.
      </p>
    </div>
  </section>

  <section id="mietprozess" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <span class="label-caps" style={`color: var(${accent})`}>Try the enquiry process</span>
        <h2 class="font-display text-3xl font-semibold mt-4">From an example property to a demo enquiry</h2>
      </div>
      <ProcessSteps
        steps={[
          { number: "1", title: "Choose a property", description: "Filter the listings and open a demo enquiry for an example property." },
          { number: "2", title: "Add your details", description: "The selected property is already in the form. Add a sample request using fictional details." },
          { number: "3", title: "Review the summary", description: "See your details brought together. You can edit or clear them; nothing is sent." },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Example contacts</span>
        <div class="space-y-4">
          <ContactPerson name={people["mara-linden"].name} roles={people["mara-linden"].roles[lang]} accentVar={accent} />
          <ContactPerson name={people["nora-feldmann"].name} roles={people["nora-feldmann"].roles[lang]} accentVar={accent} />
        </div>
        <p class="text-sm text-[var(--color-ink-muted)] mt-6 leading-relaxed">
          The names and roles illustrate possible points of contact. Use the form to try a property enquiry.
        </p>
      </div>
      <div id="property-enquiry" class="lg:col-span-8">
        <ContactForm
          lang={lang}
          area="real-estate"
          source="/en/immobilien/"
          subject="New Inquiry – Real Estate"
          submitLabel="Review demo enquiry"
          successMessage="Your example details are ready to review. Nothing has been sent."
          errorMessage="Please check the highlighted details."
          fields={[
            { type: "text", name: "name", label: "First and last name", placeholder: "Jane Doe" },
            { type: "email", name: "email", label: "Email address", placeholder: "jane@example.com" },
            { type: "select", name: "objekt", label: "Property of interest", options: ["Apartment", "Commercial", "Parking", "Not sure yet"] },
            { type: "textarea", name: "message", label: "Your message", placeholder: "How can we help you?" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-10 text-center">Frequently asked questions</h2>
      <FaqAccordion
        items={[
          { question: "Can I view or rent an apartment?", answer: "No. These are examples of how a property website could work. The demo form shows an enquiry summary but does not arrange viewings or accept rental applications." },
          { question: "Do the photographs show the example properties?", answer: "The photographs illustrate apartments, commercial spaces and parking. They are not verified Falkenried properties. The details are part of the design concept, not rental offers." },
        ]}
      />
      <div class="text-center mt-10">
        <a href={routes.faq[lang]} class="label-caps" style={`color: var(${accent})`}>View all FAQs →</a>
      </div>
    </div>
  </section>
</BaseLayout>
