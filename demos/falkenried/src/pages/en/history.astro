---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactPerson from "../../components/ContactPerson.astro";
import { routes } from "../../i18n/nav";
import heroImage from "../../assets/images/bmw/workshop-lift.jpg";
import { people } from "../../data/company";

const lang = "en";
const values = [{"title": "Personal", "text": "Clear points of contact help visitors find the right person for their enquiry."}, {"title": "Understandable", "text": "Services, next steps and essential details should be easy to understand at a glance."}, {"title": "Locally focused", "text": "The Zürcher Unterland provides the setting for a concept built around local services and everyday needs."}];
const divisions = [{"number": "01", "title": "Mobility", "text": "A workshop with a clear overview of maintenance, repairs and vehicle care."}, {"number": "02", "title": "Gardens", "text": "Design, maintenance and transport brought together in one outdoor services offering."}, {"number": "03", "title": "Property", "text": "A clear overview of rental properties and a direct route to a relevant enquiry."}];
const contacts = [{"title": "Auto Workshop & Service", "keys": ["jonas-lindberg"], "accent": "--color-bmw-text"}, {"title": "Landscaping & Maintenance", "keys": ["lukas-falkenried"], "accent": "--color-garden"}, {"title": "Real Estate & Management", "keys": ["mara-linden", "nora-feldmann"], "accent": "--color-realestate"}] as const;
---
<BaseLayout lang={lang} route="geschichte" title="About the concept | Falkenried Gruppe" description="Three divisions, one shared identity: the idea behind the fictional Falkenried company concept.">
  <Hero variant="full" title={"Three divisions. <span class=\"italic font-light\">One shared idea.</span>"} subtitle="Falkenried is a fictional company in the Zürcher Unterland. This design concept brings a workshop, landscaping and property management together under one identity." image={heroImage} imageAlt="Vehicle on a lift in a workshop" primaryCta={{ label: "Explore the divisions", href: routes.bmw[lang] }} secondaryCta={{ label: "Our guiding ideas", href: '#timeline' }} />

  <section id="timeline" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-10">What connects the divisions</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => <article class="border-l-2 border-[var(--color-primary)] pl-6"><h3 class="font-semibold text-xl mb-3">{value.title}</h3><p class="text-[var(--color-ink-muted)] leading-relaxed">{value.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-10">How the concept comes together</h2>
      <div class="grid gap-8 md:grid-cols-3">{divisions.map((division, index) => <article><h3 class="font-display text-2xl font-semibold mb-4"><a class="hover:underline underline-offset-4" href={[routes.bmw[lang], routes.gartenbau[lang], routes.immobilien[lang]][index]}>{division.title}</a></h3><p class="text-[var(--color-ink-muted)] leading-relaxed">{division.text}</p></article>)}</div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-5">Contacts in the concept</h2>
      <p class="max-w-2xl text-[var(--color-ink-muted)] mb-12">These names and roles are fictional examples of how enquiries could be directed.</p>
      <div class="grid gap-10 lg:grid-cols-3">{contacts.map((group) => <div><h3 class="font-semibold text-lg mb-6">{group.title}</h3><div class="grid gap-6">{group.keys.map((key) => <ContactPerson name={people[key].name} roles={people[key].roles[lang]} accentVar={group.accent} />)}</div></div>)}</div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-inverse-surface)] text-white text-center">
    <div class="max-w-2xl mx-auto px-6"><h2 class="font-display text-3xl font-semibold mb-6">Try the contact journey</h2><p class="text-white/85 mb-10 leading-relaxed">Choose a division and explore the enquiry form using fictional test details.</p><a href={routes.kontakt[lang]} class="btn-primary">Open demo contact</a></div>
  </section>
</BaseLayout>
