---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ServiceList from "../../components/ServiceList.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import ContactPerson from "../../components/ContactPerson.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import Testimonial from "../../components/Testimonial.astro";
import SectionNav from "../../components/SectionNav.astro";
import { Image } from "astro:assets";
import { routes } from "../../i18n/nav";
import { automotiveBusinessSchema } from "../../lib/schema";
import { bmwOpeningHours, externalLinks, people } from "../../data/company";
import heroImage from "../../assets/images/bmw/workshop-hero.jpg";
import detailImage from "../../assets/images/bmw/workshop-detail.jpg";

const lang = "en";
const accent = "--color-bmw-text" as const;
const formatRanges = (ranges: readonly (readonly [string, string])[]) => ranges.map(([opens, closes]) => `${opens}–${closes}`).join(" · ");
---

<BaseLayout
  lang={lang}
  route="bmw"
  title="Car servicing | Maintenance and vehicle care | Falkenried Gruppe"
  description="A workshop concept with maintenance, repairs, used cars, a fuel station and vehicle care. Explore the example services at Falkenried."
  jsonLd={automotiveBusinessSchema(lang)}
>
  <Hero
    variant="full"
    eyebrow="BMW SERVICE · DESIGN CONCEPT"
    title={`Precision in <span class="italic font-light">every turn.</span>`}
    subtitle="Maintenance, repairs and vehicle care: find the right service for your BMW and try the enquiry process."
    image={heroImage}
    imageAlt="BMW in front of the garage"
    primaryCta={{ label: "Try a service enquiry", href: routes.kontakt[lang] + "#general-inquiry" }}
    secondaryCta={{ label: "View services", href: "#services" }}
  />

  <SectionNav label="Workshop pages" activePath={routes.bmw[lang]} accentVar="--color-bmw-text" items={[
    { label: "Overview", href: routes.bmw[lang] },
    { label: "Service", href: routes.bmwService[lang] },
    { label: "Used cars", href: routes.bmwOccasions[lang] },
    { label: "Service station", href: routes.bmwStation[lang] },
    { label: "Accessories", href: routes.bmwAccessories[lang] },
  ]} />

  <section id="services" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <span class="label-caps" style={`color: var(${accent})`}>Our services</span>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold mt-4">Services for your vehicle</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div class="card p-8 border-t-4" style={`border-top-color: var(${accent})`}>
          <h3 class="font-semibold text-lg mb-3">Maintenance and repairs</h3>
          <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed">
            From finding a fault to repairing it: explore the possible workshop services and see what information helps with an enquiry.
          </p>
        </div>
        <div class="card p-8 border-t-4" style={`border-top-color: var(${accent})`}>
          <h3 class="font-semibold text-lg mb-3">Used cars in the concept</h3>
          <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed">
            The used-car page shows how a vehicle listing could be presented. No vehicles are offered for sale in this demo.
          </p>
        </div>
        <div class="card p-8 border-t-4" style={`border-top-color: var(${accent})`}>
          <h3 class="font-semibold text-lg mb-3">Fuel station and car wash</h3>
          <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed">
            Refuel and charge around the clock, with separate opening hours for the car wash. The service station page shows example hours and payment options.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-lowest)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1">
          <span class="label-caps mb-6 block" style={`color: var(${accent})`}>WORKSHOP OVERVIEW</span>
          <h2 class="font-display text-3xl font-semibold mb-8">The right service for your needs</h2>
          <p class="text-lg text-[var(--color-ink-muted)] mb-10 leading-relaxed">
            Is a service due, do you need to discuss damage, or are you looking for accessories?
            Each section leads you to the relevant services and an example enquiry.
          </p>
          <ServiceList
            accentVar={accent}
            items={[
              "Maintenance and repairs in the workshop concept",
              "An example used-car listing page",
              "Fuel station, charge points and car wash",
            ]}
          />
          <a href={routes.kontakt[lang] + "#general-inquiry"} class="btn-primary mt-10 inline-flex">Try a service enquiry</a>
        </div>
        <div class="order-1 lg:order-2 relative">
          <div class="aspect-[4/3] rounded-xl overflow-hidden">
            <Image src={detailImage} alt="Classic BMW cars in a showroom" class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(min-width: 1024px) 45vw, 90vw" />
          </div>
          <div class="absolute -bottom-8 -right-8 bg-[var(--color-surface)] p-8 hidden lg:block rounded-lg border border-[var(--color-outline-variant)]/40">
            <span class="block font-display text-[var(--color-primary)] text-5xl font-bold mb-1">BMW</span>
            <span class="block label-caps text-[var(--color-ink-muted)]">Workshop concept</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <span class="label-caps" style={`color: var(${accent})`}>Process</span>
        <h2 class="font-display text-3xl font-semibold mt-4">How the demo enquiry works</h2>
      </div>
      <ProcessSteps
        steps={[
          { number: "1", title: "Describe your request", description: "Describe your service needs in the demo form. No appointment is reserved and nothing is sent." },
          { number: "2", title: "Review your details", description: "The form brings your entries together in a summary. Nothing has been sent and no appointment has been booked." },
          { number: "3", title: "Edit or clear", description: "Return to the form to edit your entries, or clear the example details." },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-3xl font-semibold mb-8">Example workshop opening hours</h2>
      <dl class="divide-y divide-[var(--color-outline-variant)]/40">
        <div class="flex justify-between py-4 gap-6"><dt>Mon–Thu</dt><dd>{formatRanges(bmwOpeningHours.monday)}</dd></div>
        <div class="flex justify-between py-4 gap-6"><dt>Fri</dt><dd>{formatRanges(bmwOpeningHours.friday)}</dd></div>
        <div class="flex justify-between py-4 gap-6"><dt>Sat</dt><dd>{formatRanges(bmwOpeningHours.saturday)}</dd></div>
        <div class="flex justify-between py-4 gap-6"><dt>Sun</dt><dd>closed</dd></div>
      </dl>
      <p class="text-sm text-[var(--color-ink-muted)] mt-5">In this example, the workshop closes on the last Saturday of the month. These are demo hours, not visiting times for a real business.</p>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-primary)] text-white">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-12">Your contact in this example</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-2xl">
        <ContactPerson name={people["jonas-lindberg"].name} roles={people["jonas-lindberg"].roles[lang]} accentVar={accent} dark />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16">
      <Testimonial
        accentVar={accent}
        quote="Explain the services clearly and make the next step easy."
        name="Guiding idea"
        role="Workshop concept"
      />
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Frequently asked questions</span>
        <FaqAccordion
          items={[
            { question: "Is Falkenried an official BMW dealer?", answer: "No. Falkenried is a fictional business. BMW is used as an example vehicle brand; the demo does not establish any manufacturer partnership or certification." },
            { question: "Do you offer a replacement vehicle during workshop visits?", answer: "For a real service enquiry, the need for a replacement car, its availability and cost would need to be agreed. You can describe this request in the demo form; no vehicle is reserved." },
          ]}
        />
        <a href={routes.faq[lang]} class="label-caps mt-8 inline-block" style={`color: var(${accent})`}>View all FAQs →</a>
      </div>
    </div>
  </section>
</BaseLayout>
