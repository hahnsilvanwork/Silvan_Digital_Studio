---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqTabs from "../../components/FaqTabs.astro";
import { routes, common } from "../../i18n/nav";
import { organizationSchema, faqSchema } from "../../lib/schema";
import { bmwFaqs } from "../../data/bmw";

const lang = "en";
const c = common[lang];

const groups = [
  {
    key: "bmw",
    label: "Car servicing",
    items: [
      ...bmwFaqs.map((item) => ({ question: item.question.en, answer: item.answer.en })),
      { question: "What details help with a service enquiry?", answer: "Include the model, mileage and the work you have in mind. If something is wrong, a brief description helps: what have you noticed, and when does it happen?" },
      { question: "Does the example include binding warranty promises?", answer: "No. This demo does not confirm manufacturer partnerships, warranties or service-package coverage. These points would need to be checked for the individual vehicle before any real work." },
      { question: "How can I mention that I need replacement transport?", answer: "Mention in your example enquiry if you would need a vehicle during the repair. The form includes this request in your summary. It does not reserve a replacement car." },
      { question: "Which services does the website describe?", answer: "The service page explains holiday checks, air-conditioning servicing, windscreen repairs and body repairs, among other examples. The descriptions help you find the relevant topic for your enquiry." },
      { question: "What does the service station include?", answer: "The example includes a self-service fuel station, two charge points, wash bays and a vacuum cleaner. Fuel and charging are shown with 24-hour access. The wash bays and vacuum have separate opening hours." },
    ],
  },
  {
    key: "gartenbau",
    label: "Landscaping",
    items: [
      { question: "Which region is the landscaping concept based in?", answer: "The Zürcher Unterland provides the regional setting for this business example. This describes the demo rather than an actual service area." },
      { question: "What should I consider when planning a garden redesign?", answer: "Start with how you want to use the garden and how much maintenance suits you. Spring and autumn offer favourable conditions for many planting tasks. Soil, location and plant choice also matter." },
      { question: "What does garden maintenance include?", answer: "The overview covers lawn care, pruning, planting, rose care and other seasonal tasks. The garden size, existing planting and the work you have in mind are useful details for an example enquiry." },
      { question: "What can I describe in a garden enquiry?", answer: "For example, a new seating area, paths, walls, a fountain or different planting. Describe the existing garden, what you would like to change and your preferred timing." },
    ],
  },
  {
    key: "immobilien",
    label: "Property",
    items: [
      { question: "Which properties does the website show?", answer: "The property page shows example homes and commercial spaces with sample locations, sizes and rents. They are not available rental properties." },
      { question: "Where can I find the details of a property?", answer: "The property cards show the main example details. Following a demo enquiry link preselects that property in the form." },
      { question: "Are the displayed rents binding?", answer: "No. The prices are sample figures for this design concept. There is no rental offer or agreement on a deposit, additional charges or other contract terms." },
      { question: "Can I reserve a property or book a viewing?", answer: "No. You can complete and review a demo enquiry. It is not sent and does not arrange a reservation or viewing." },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  route="faq"
  title="Frequently asked questions | Falkenried Gruppe"
  description="Answers about the example car servicing, landscaping and property services, and how to use the Falkenried demo."
  jsonLd={[organizationSchema(lang), faqSchema(groups.flatMap((g) => g.items))]}
>
  <section class="pt-40 pb-20 bg-[var(--color-surface)] text-center">
    <div class="max-w-2xl mx-auto px-6 lg:px-16">
      <h1 class="font-display text-4xl font-bold mb-6">Frequently asked questions</h1>
      <p class="text-[var(--color-ink-muted)] leading-relaxed">
        Find answers about car servicing, landscaping and property. Choose the area
        that relates to your enquiry.
      </p>
    </div>
  </section>

  <section class="pb-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <FaqTabs groups={groups} />
    </div>
  </section>

  <section class="py-20 bg-[var(--color-surface-low)]">
    <div class="max-w-2xl mx-auto px-6 lg:px-16 text-center">
      <h2 class="font-display text-2xl font-semibold mb-4">Still have questions?</h2>
      <p class="text-[var(--color-ink-muted)] mb-8 leading-relaxed">
        Try describing an enquiry in the contact form. The demo displays your details as a summary for you to review.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href={routes.kontakt[lang]} class="btn-primary">Try a demo enquiry</a>
        <a href={c.phoneHref} class="btn-secondary">Read demo notice</a>
      </div>
    </div>
  </section>
</BaseLayout>
