---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ServiceList from "../../components/ServiceList.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import Testimonial from "../../components/Testimonial.astro";
import ContactForm from "../../components/ContactForm.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import SectionNav from "../../components/SectionNav.astro";
import { Image } from "astro:assets";
import { routes } from "../../i18n/nav";
import { people } from "../../data/company";
import { organizationSchema } from "../../lib/schema";
import heroImage from "../../assets/images/garden/garden-aerial.jpg";
import pathImage from "../../assets/images/garden/garden-path.jpg";
import hedgeImage from "../../assets/images/garden/hedge-work.jpg";

const lang = "en";
const accent = "--color-garden" as const;
---

<BaseLayout
  lang={lang}
  route="gartenbau"
  title="Landscaping | Garden design and maintenance | Falkenried Gruppe"
  description="Garden design, maintenance and transport in the Falkenried concept. Explore garden ideas and try a project enquiry."
  jsonLd={organizationSchema(lang)}
>
  <Hero
    variant="full"
    eyebrow="LANDSCAPE DESIGN & CARE"
    title={`Your garden. <span class="italic font-light">Your favourite place.</span>`}
    subtitle="A new seating area, planting that suits the space or regular care: explore how a garden can fit your wishes and everyday life."
    image={heroImage}
    imageAlt="Geometrically clipped hedges in front of a historic building"
    primaryCta={{ label: "Try a project enquiry", href: routes.kontakt[lang] }}
    secondaryCta={{ label: "View services", href: "#expertise" }}
  />
  <SectionNav label="Landscaping pages" activePath={routes.gartenbau[lang]} accentVar="--color-garden" items={[
    { label: "Overview", href: routes.gartenbau[lang] }, { label: "Design", href: routes.gardenDesign[lang] },
    { label: "Maintenance", href: routes.gardenMaintenance[lang] }, { label: "Skips & transport", href: routes.gardenTransport[lang] },
    { label: "Garden ideas", href: routes.gardenReferences[lang] }, { label: "Tips", href: routes.gardenTips[lang] },
  ]} />

  <section id="expertise" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Garden design and planning</span>
        <h2 class="font-display text-3xl font-semibold mb-8">Planning your garden</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
          How would you like to use your garden? A seating area, new paths or a water feature need
          a plan that brings your wishes, the site and the planting together.
        </p>
        <ServiceList accentVar={accent} items={["Planning and new gardens", "Paths, walls and seating areas", "Water features and earthworks"]} />
      </div>
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Garden care and maintenance</span>
        <h2 class="font-display text-3xl font-semibold mb-8">Keeping your garden in good shape</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
          Lawns, hedges and borders need attention at different times.
          Seasonal work and regular care help keep the garden in good shape.
        </p>
        <ServiceList accentVar={accent} items={["Seasonal pruning & tree care", "Lawn care & plant protection", "Year-round care & winter protection"]} />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <h2 class="font-display text-3xl font-semibold italic font-light">How your garden project could take shape</h2>
      </div>
      <ProcessSteps
        steps={[
          { number: "1", title: "Consultation", description: "Discuss your wishes, the garden size and the existing conditions together." },
          { number: "2", title: "Concept", description: "Plan the layout, materials and planting so they work together." },
          { number: "3", title: "Build", description: "Agree on the work and schedule before construction starts." },
          { number: "4", title: "Ongoing care", description: "Decide what care the garden will need and who will look after it." },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="grid grid-cols-2 gap-4">
        <div class="aspect-square rounded-lg overflow-hidden">
          <Image src={pathImage} alt="Garden with water feature and planting" class="w-full h-full object-cover" widths={[300, 600]} sizes="300px" />
        </div>
        <div class="aspect-square rounded-lg overflow-hidden mt-10">
          <Image src={hedgeImage} alt="Blooming roses and perennials in the garden" class="w-full h-full object-cover" widths={[300, 600]} sizes="300px" />
        </div>
      </div>
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>OUR APPROACH</span>
        <h2 class="font-display text-3xl font-semibold mb-8">A garden for everyday life</h2>
        <p class="text-lg text-[var(--color-ink-muted)] mb-10 leading-relaxed">
          A garden should do more than look beautiful. It should make room for what matters to you:
          eating outdoors, spending time with family or simply unwinding. How you use and care for it belongs in the plan from the start.
        </p>
        <Testimonial
          accentVar={accent}
          quote="A garden should suit the people who spend time in it."
          name="Guiding idea"
          role="Garden concept"
        />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Project enquiry</span>
        <h2 class="font-display text-3xl font-semibold mb-6">Try out your project idea</h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed">
          Describe an example project and review your details in a summary. Use fictional test details. Nothing is sent and no consultation is arranged.
        </p>
      </div>
      <ContactForm
        lang={lang}
        area="garden"
        source="/en/gartenbau/"
        subject="New Inquiry – Landscaping"
        submitLabel="Review demo enquiry"
        successMessage="Your example details are ready to review. Nothing has been sent."
        errorMessage="Please check the highlighted details."
        fields={[
          { type: "text", name: "name", label: "First and last name", placeholder: "Jane Doe" },
          { type: "email", name: "email", label: "Email address", placeholder: "jane@example.com" },
          { type: "select", name: "interesse", label: "Your request", options: ["Redesign and planning", "Garden maintenance", "Both / Not sure"] },
          { type: "textarea", name: "message", label: "Message", placeholder: "How can we help you?" },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-10 text-center">Frequently asked questions</h2>
      <FaqAccordion
        items={[
          { question: "What's the best time for a redesign?", answer: "Spring and autumn offer favourable conditions for many planting tasks. The best time depends on the soil, location and plants. Planning can be considered separately." },
          { question: "Do you offer regular garden maintenance?", answer: "The example services include lawn care, pruning, planting and other garden work. One-off visits and regular care would be agreed according to your needs." },
        ]}
      />
      <div class="text-center mt-10">
        <a href={routes.faq[lang]} class="label-caps" style={`color: var(${accent})`}>View all FAQs →</a>
      </div>
    </div>
  </section>
</BaseLayout>
