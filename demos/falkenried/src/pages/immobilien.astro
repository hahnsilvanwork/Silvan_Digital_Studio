---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PropertyFilter from "../components/PropertyFilter.astro";
import PropertyCard from "../components/PropertyCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ContactPerson from "../components/ContactPerson.astro";
import ContactForm from "../components/ContactForm.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { routes } from "../i18n/nav";
import { realEstateSchema } from "../lib/schema";
import { people } from "../data/company";
import heroImage from "../assets/images/immobilien/apartment-living-1.jpg";
import apartmentImg from "../assets/images/immobilien/apartment-living-2.jpg";
import officeImg from "../assets/images/immobilien/office-glass.jpg";
import parkingImg from "../assets/images/immobilien/parking-garage.jpg";

const lang = "de";
const accent = "--color-realestate" as const;
---

<BaseLayout
  lang={lang}
  route="immobilien"
  title="Immobilien | Wohnungen, Gewerbe und Parkplätze | Falkenried Gruppe"
  description="Beispielobjekte im Falkenried-Konzept: Wohnungen, Gewerberäume und Parkplätze. Filtern Sie die Übersicht und probieren Sie eine Objektanfrage aus."
  jsonLd={realEstateSchema(lang)}
>
  <Hero
    variant="full"
    eyebrow="IMMOBILIEN IM ÜBERBLICK"
    title={`Raum zum Wohnen. <span class="italic font-light">Platz zum Arbeiten.</span>`}
    subtitle="Wohnungen, Gewerberäume und Parkplätze: Entdecken Sie die Beispielobjekte und probieren Sie eine unverbindliche Demo-Anfrage aus."
    image={heroImage}
    imageAlt="Modernes Wohninterieur mit grossen Fenstern"
    primaryCta={{ label: "Objekte ansehen", href: "#objekte" }}
    secondaryCta={{ label: "Anfrageablauf", href: "#mietprozess" }}
  />

  <section id="objekte" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="mb-10">
        <span class="label-caps mb-4 block" style={`color: var(${accent})`}>Beispielobjekte</span>
        <h2 class="font-display text-3xl font-semibold">Wohnungen, Gewerberäume und Parkplätze</h2>
      </div>
      <PropertyFilter
        gridId="property-grid"
        filters={[
          { key: "all", label: "Alle" },
          { key: "wohnungen", label: "Wohnungen" },
          { key: "gewerbe", label: "Gewerbe" },
          { key: "parkplatz", label: "Parkplatz" },
        ]}
      />
      <div id="property-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <PropertyCard
          image={apartmentImg}
          imageAlt="Heller Wohnraum als Symbolbild für ein Beispielobjekt"
          status="Auf Anfrage"
          statusTone="neutral"
          category="wohnungen"
          title="Wohnung, Zürcher Unterland Chlupf"
          address="Beispiellage im Zürcher Unterland"
          price="Preis auf Anfrage"
          priceLabel="Monatsmiete"
          detailsLabel="Demo-Anfrage"
        />
        <PropertyCard
          image={officeImg}
          imageAlt="Moderner Büroraum als Symbolbild für eine Gewerbefläche"
          status="Auf Anfrage"
          statusTone="neutral"
          category="gewerbe"
          title="Gewerbefläche, Steinbruggstrasse"
          address="Beispiellage nahe einem Bahnhof im Zürcher Unterland"
          price="Preis auf Anfrage"
          priceLabel="Monatsmiete"
          detailsLabel="Demo-Anfrage"
        />
        <PropertyCard
          image={parkingImg}
          imageAlt="Tiefgarage als Symbolbild für einen Einstellhallenplatz"
          status="Auf Anfrage"
          statusTone="neutral"
          category="parkplatz"
          title="Einstellhallenplatz"
          address="Zürcher Unterland Chlupf"
          price="Preis auf Anfrage"
          priceLabel="Monatsmiete"
          detailsLabel="Demo-Anfrage"
        />
      </div>
      <p class="text-sm text-[var(--color-ink-muted)] mt-8">
        Die Objekte und Preise gehören zum Designkonzept. Es werden keine tatsächlich verfügbaren Räume oder Parkplätze angeboten. Über «Demo-Anfrage» übernehmen Sie das gewählte Objekt in das Formular.
      </p>
    </div>
  </section>

  <section id="mietprozess" class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16">
      <div class="text-center mb-16">
        <span class="label-caps" style={`color: var(${accent})`}>Anfrage zum Ausprobieren</span>
        <h2 class="font-display text-3xl font-semibold mt-4">Vom Beispielobjekt zur Demo-Anfrage</h2>
      </div>
      <ProcessSteps
        steps={[
          { number: "1", title: "Objekt auswählen", description: "Filtern Sie die Übersicht und öffnen Sie bei einem Beispielobjekt die Demo-Anfrage." },
          { number: "2", title: "Angaben ergänzen", description: "Das gewählte Objekt steht bereits im Formular. Ergänzen Sie Ihr Beispielanliegen mit erfundenen Testdaten." },
          { number: "3", title: "Übersicht prüfen", description: "Sehen Sie Ihre Angaben zusammengefasst. Sie können sie bearbeiten oder löschen; es wird nichts versendet." },
        ]}
      />
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface)]">
    <div class="max-w-[var(--container-max)] mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <span class="label-caps mb-6 block" style={`color: var(${accent})`}>Ansprechpersonen im Beispiel</span>
        <div class="space-y-4">
          <ContactPerson name={people["mara-linden"].name} roles={people["mara-linden"].roles[lang]} accentVar={accent} />
          <ContactPerson name={people["nora-feldmann"].name} roles={people["nora-feldmann"].roles[lang]} accentVar={accent} />
        </div>
        <p class="text-sm text-[var(--color-ink-muted)] mt-6 leading-relaxed">
          Die Namen und Rollen zeigen beispielhafte Ansprechpersonen. Im Formular können Sie den Ablauf einer Objektanfrage ausprobieren.
        </p>
      </div>
      <div id="property-enquiry" class="lg:col-span-8">
        <ContactForm
          lang={lang}
          area="real-estate"
          source="/immobilien/"
          subject="Neue Anfrage – Immobilien"
          submitLabel="Demo-Anfrage prüfen"
          successMessage="Ihre Beispielangaben sind bereit zur Prüfung. Es wurde nichts versendet."
          errorMessage="Bitte prüfen Sie die markierten Angaben."
          fields={[
            { type: "text", name: "name", label: "Vorname und Nachname", placeholder: "Max Mustermann" },
            { type: "email", name: "email", label: "E-Mail-Adresse", placeholder: "max@beispiel.ch" },
            { type: "select", name: "objekt", label: "Gewünschtes Objekt", options: ["Wohnung", "Gewerbe", "Parkplatz", "Noch unsicher"] },
            { type: "textarea", name: "message", label: "Ihre Nachricht", placeholder: "Wie können wir Ihnen helfen?" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="py-[var(--spacing-section-gap)] bg-[var(--color-surface-low)]">
    <div class="max-w-3xl mx-auto px-6 lg:px-16">
      <h2 class="font-display text-2xl font-semibold mb-10 text-center">Häufige Fragen</h2>
      <FaqAccordion
        items={[
          { question: "Kann ich eine Wohnung besichtigen oder mieten?", answer: "Nein. Die Objekte sind Beispiele für den Aufbau einer Immobilienwebsite. Das Demoformular zeigt eine Anfrageübersicht, vereinbart aber keinen Termin und nimmt keine Mietbewerbung entgegen." },
          { question: "Gehören die Fotos zu den Beispielobjekten?", answer: "Die Fotos sind Symbolbilder für Wohnungen, Gewerberäume und Parkplätze. Sie zeigen keine nachgewiesenen Falkenried-Objekte. Die Angaben dienen dem Designkonzept und sind kein Mietangebot." },
        ]}
      />
      <div class="text-center mt-10">
        <a href={routes.faq[lang]} class="label-caps" style={`color: var(${accent})`}>Alle Fragen ansehen →</a>
      </div>
    </div>
  </section>
</BaseLayout>
