---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../i18n/nav";
import { routes } from "../i18n/nav";

interface Props {
  lang: Lang;
  route: keyof typeof routes;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
}

const { lang, route, title, description, jsonLd, ogImage = "/images/og-default.jpg", noindex = true } = Astro.props;

const canonicalPath = routes[route][lang];
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateDe = new URL(routes[route].de, Astro.site);
const alternateEn = new URL(routes[route].en, Astro.site);

const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={lang === "de" ? "de_CH" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />


  </head>
  <body class="antialiased">
    <a href="#main" class="skip-link">{lang === "de" ? "Zum Inhalt springen" : "Skip to content"}</a>
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <aside id="demo-hinweis" class="demo-notice">{lang === "de" ? "Designkonzept · Falkenried ist ein erfundenes Unternehmen. Alle Angaben dienen der Demonstration. Es werden keine Anfragen versendet." : "Design concept · Falkenried is a fictional business. All details are illustrative. No enquiries are sent."}</aside>
    <Footer lang={lang} />
  </body>
</html>
